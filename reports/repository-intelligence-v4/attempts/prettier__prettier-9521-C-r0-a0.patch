@@ -0,0 +1,23 @@
+#### Format nested generic types consistently with Babel (#9521)
+
+Avoid keeping a nested generic type argument on the same line when its own type
+arguments need to break across lines.
+
+<!-- prettier-ignore -->
+```ts
+// Input
+const name: SomeGeneric<
+  Pick<Config, "ONE_LONG_PROP" | "ANOTHER_LONG_PROP">
+> = null;
+
+// Prettier stable
+const name: SomeGeneric<Pick<
+  Config,
+  "ONE_LONG_PROP" | "ANOTHER_LONG_PROP"
+>> = null;
+
+// Prettier master
+const name: SomeGeneric<
+  Pick<Config, "ONE_LONG_PROP" | "ANOTHER_LONG_PROP">
+> = null;
+```
