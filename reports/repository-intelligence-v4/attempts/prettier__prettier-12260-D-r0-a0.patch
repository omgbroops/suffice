@@ -1,3 +1,15 @@
 run_spec(__dirname, ["babel"], {
   errors: { acorn: true, espree: true, meriyah: ["multiple.js", "mobx.js"] },
 });
+
+const prettier = require("prettier-local");
+
+test.each(["babel", "babel-ts"])(
+  "decorated class expressions without semicolons (%s)",
+  (parser) => {
+    const options = { parser, semi: false };
+    const output = prettier.format("foo(); (@f() class {});", options);
+    expect(output).toContain(";(@f()");
+    expect(prettier.format(output, options)).toBe(output);
+  }
+);
