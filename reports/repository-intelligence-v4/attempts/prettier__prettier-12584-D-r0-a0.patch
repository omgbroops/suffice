diff --git a/tests/format/vue/typescript-expressions/jsfmt.spec.js b/tests/format/vue/typescript-expressions/jsfmt.spec.js
new file mode 100644
index 0000000..f40f37c
--- /dev/null
+++ b/tests/format/vue/typescript-expressions/jsfmt.spec.js
@@ -0,0 +1,71 @@
+const prettier = require("prettier-local");
+
+const format = (source) => prettier.format(source, { parser: "vue" });
+
+describe("TypeScript in Vue templates", () => {
+  test.each([
+    '<script lang="ts"></script>',
+    '<script setup lang="ts"></script>',
+    '<script lang="tsx"></script>',
+    '<script></script>\n<script setup lang="ts"></script>',
+  ])("interpolation with %s", (script) => {
+    const source =
+      "<template><p>{{ (file  as  mymodule.Folder).deadline }}</p></template>\n" +
+      script;
+    const output = format(source);
+    expect(output).toContain("{{ (file as mymodule.Folder).deadline }}");
+    expect(format(output)).toBe(output);
+  });
+
+  test.each([
+    [':value="file  as  Folder"', ':value="file as Folder"'],
+    ['v-if="(file  as  Folder).deadline"', 'v-if="(file as Folder).deadline"'],
+    ['@click="file = value  as  Folder"', '@click="file = value as Folder"'],
+    [
+      '@click="file = value  as  Folder; save(file!)"',
+      "file = value as Folder; save(file!);",
+    ],
+    [
+      '@click="(event: Event) => save(event)"',
+      '@click="(event: Event) => save(event)"',
+    ],
+    [
+      'v-for="file in files  as  Folder[]"',
+      'v-for="file in files as Folder[]"',
+    ],
+    [
+      'v-slot="{ file }: { file: Folder }"',
+      'v-slot="{ file }: { file: Folder }"',
+    ],
+  ])("directive %s", (attribute, expected) => {
+    const output = format(
+      "<template><p " +
+        attribute +
+        ' /></template>\n<script setup lang="ts"></script>'
+    );
+    expect(output.replace(/\s+/g, " ")).toContain(expected);
+    expect(format(output)).toBe(output);
+  });
+
+  test("script can precede template", () => {
+    expect(
+      format(
+        '<script lang="ts"></script>\n<template>{{ value  as  string }}</template>'
+      )
+    ).toContain("{{ value as string }}");
+  });
+
+  test("comments and non-null assertions", () => {
+    const output = format(
+      '<template>{{ /* comment */ value!  as  string }}</template>\n<script lang="ts"></script>'
+    );
+    expect(output).toContain("{{ /* comment */ value! as string }}");
+    expect(format(output)).toBe(output);
+  });
+
+  test("ordinary JavaScript templates still support Vue filters", () => {
+    expect(format("<template>{{ value|filter }}</template>")).toBe(
+      "<template>{{ value | filter }}</template>\n"
+    );
+  });
+});
