diff --git a/lib/plugins/aws/package/lib/mergeCustomProviderResources.js b/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
index 414b098..538e36c 100644
--- a/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
+++ b/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
@@ -17,6 +17,28 @@ module.exports = {
       this.serverless.service.resources
     );
 
+    const resources = this.serverless.service.provider.compiledCloudFormationTemplate.Resources;
+    const deploymentLogicalId = Object.keys(resources).find((logicalId) =>
+      logicalId.startsWith('ApiGatewayDeployment')
+      && resources[logicalId].Type === 'AWS::ApiGateway::Deployment');
+
+    if (deploymentLogicalId) {
+      const customResources = (this.serverless.service.resources || {}).Resources || {};
+      _.forEach(customResources, (resource, logicalId) => {
+        if (resource.Type !== 'AWS::ApiGateway::BasePathMapping') return;
+
+        const mergedResource = resources[logicalId];
+        const dependencies = mergedResource.DependsOn;
+        if (!dependencies) {
+          mergedResource.DependsOn = deploymentLogicalId;
+        } else if (Array.isArray(dependencies)) {
+          if (!_.includes(dependencies, deploymentLogicalId)) dependencies.push(deploymentLogicalId);
+        } else if (dependencies !== deploymentLogicalId) {
+          mergedResource.DependsOn = [dependencies, deploymentLogicalId];
+        }
+      });
+    }
+
     return BbPromise.resolve();
   },
 };
