+## Depend on the API Gateway deployment
+
+The API Gateway deployment has a generated logical ID that changes with each deployment. To make a custom resource wait for the API stage to be deployed, use `ApiGatewayDeployment` in `DependsOn`. Serverless replaces this alias with the generated deployment logical ID. Both a string and a list of dependencies are supported. This requires an API Gateway deployment generated by HTTP events in this service.
+
+```yml
+resources:
+  Resources:
+    PathMapping:
+      Type: AWS::ApiGateway::BasePathMapping
+      DependsOn: ApiGatewayDeployment
+      Properties:
+        BasePath: oauth2
+        DomainName: ${self:custom.domainName}
+        RestApiId:
+          Ref: ApiGatewayRestApi
+        Stage: ${self:provider.stage}
+```
+
 ## Override AWS CloudFormation Resource
 
 You can override the specific CloudFormation resource to apply your own options. For example, if you want to set `AWS::Logs::LogGroup` retention time to 30 days, override it with above table's `Name Template`.
diff --git a/lib/plugins/aws/package/lib/mergeCustomProviderResources.js b/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
index 414b098..dbdeac0 100644
--- a/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
+++ b/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
@@ -12,11 +12,31 @@ module.exports = {
       this.serverless.service.resources.Outputs = {};
     }
 
+    const template = this.serverless.service.provider.compiledCloudFormationTemplate;
+    const deploymentLogicalId = Object.keys(template.Resources).find(logicalId =>
+      logicalId.indexOf('ApiGatewayDeployment') === 0 &&
+      template.Resources[logicalId].Type === 'AWS::ApiGateway::Deployment'
+    );
+
     _.merge(
       this.serverless.service.provider.compiledCloudFormationTemplate,
       this.serverless.service.resources
     );
 
+    // The deployment ID changes on every package to force an API redeployment.
+    // Allow custom resources to depend on it without knowing that generated ID.
+    if (deploymentLogicalId) {
+      const resolveDependency = dependency => (dependency === 'ApiGatewayDeployment'
+        ? deploymentLogicalId : dependency);
+      _.forEach(template.Resources, resource => {
+        if (Array.isArray(resource.DependsOn)) {
+          resource.DependsOn = resource.DependsOn.map(resolveDependency);
+        } else if (typeof resource.DependsOn === 'string') {
+          resource.DependsOn = resolveDependency(resource.DependsOn);
+        }
+      });
+    }
+
     return BbPromise.resolve();
   },
 };
