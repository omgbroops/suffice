diff --git a/tests/unit/__tests__/front-matter.js b/tests/unit/__tests__/front-matter.js
new file mode 100644
index 0000000..7aed17c
--- /dev/null
+++ b/tests/unit/__tests__/front-matter.js
@@ -0,0 +1,36 @@
+"use strict";
+
+const prettier = require("prettier/local");
+const parseFrontMatter = require("../../../src/utils/front-matter");
+
+describe("front matter with a language label", () => {
+  test.each(["html", "markdown", "css"])("%s preserves custom content", (parser) => {
+    const frontMatter = "---mycustomparser\n  \ntitle: Hello\nslug: home\n\n---";
+    const body = parser === "css" ? "a{color:red}" : "<h1>\n  Hello world!</h1>";
+    const input = frontMatter + "\n\n" + body;
+    const output = prettier.format(input, { parser });
+
+    expect(output).toBe(
+      frontMatter + "\n\n" + prettier.format(body, { parser })
+    );
+    expect(prettier.format(output, { parser })).toBe(output);
+  });
+
+  test.each(["---", "+++"])("recognizes labels after %s", (delimiter) => {
+    const raw = delimiter + "custom-engine \t\nnot: necessarily: yaml\n" + delimiter;
+    const text = raw + "\nbody";
+    const result = parseFrontMatter(text);
+
+    expect(result.frontMatter.raw).toBe(raw);
+    expect(result.frontMatter.language).toBe("custom-engine");
+    expect(result.frontMatter.value).toBe("not: necessarily: yaml");
+    expect(result.content.length).toBe(text.length);
+    expect(result.content.split("\n").length).toBe(text.split("\n").length);
+    expect(result.content.endsWith("body")).toBe(true);
+  });
+
+  test("requires a matching closing delimiter", () => {
+    const text = "---custom\ntitle: Hello\n+++\n";
+    expect(parseFrontMatter(text)).toEqual({ frontMatter: null, content: text });
+  });
+});
