+## Depend on the API Gateway deployment
+
+The API Gateway deployment logical ID includes a generated suffix so that API changes
+are deployed on each stack update. To make a custom resource wait for that deployment,
+use `ApiGatewayDeployment` in its `DependsOn` property. Serverless replaces this
+reference with the generated logical ID when packaging the service. Both a single
+string and a list of dependencies are supported.
+
+For example, a base path mapping must wait until the deployment creates the stage:
+
+```yml
+resources:
+  Resources:
+    PathMapping:
+      Type: AWS::ApiGateway::BasePathMapping
+      DependsOn: ApiGatewayDeployment
+      Properties:
+        BasePath: oauth2
+        DomainName: ${self:custom.domainName}
+        RestApiId:
+          Ref: ApiGatewayRestApi
+        Stage: ${self:provider.stage}
+```
+
+This requires the service to generate an API Gateway deployment (through HTTP events).
+
 ## Override AWS CloudFormation Resource
 
 You can override the specific CloudFormation resource to apply your own options. For example, if you want to set `AWS::Logs::LogGroup` retention time to 30 days, override it with above table's `Name Template`.
diff --git a/lib/plugins/aws/package/lib/mergeCustomProviderResources.js b/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
index 414b098..117d9eb 100644
--- a/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
+++ b/lib/plugins/aws/package/lib/mergeCustomProviderResources.js
@@ -17,6 +17,26 @@ module.exports = {
       this.serverless.service.resources
     );
 
+    const resources = this.serverless.service.provider.compiledCloudFormationTemplate.Resources;
+    const deploymentLogicalId = _.findKey(resources, (resource, logicalId) =>
+      resource.Type === 'AWS::ApiGateway::Deployment' &&
+      logicalId.startsWith('ApiGatewayDeployment')
+    );
+
+    if (deploymentLogicalId) {
+      // The deployment ID changes on every package to force API Gateway to redeploy.
+      // Allow custom resources to depend on it without knowing that generated ID.
+      _.forEach(resources, (resource) => {
+        if (Array.isArray(resource.DependsOn)) {
+          resource.DependsOn = resource.DependsOn.map(dependency =>
+            (dependency === 'ApiGatewayDeployment' ? deploymentLogicalId : dependency)
+          );
+        } else if (resource.DependsOn === 'ApiGatewayDeployment') {
+          resource.DependsOn = deploymentLogicalId;
+        }
+      });
+    }
+
     return BbPromise.resolve();
   },
 };
