+  createFromPath() {
+    const templatePath = _.toString(this.options['template-path']);
+    if (!templatePath) {
+      throw new this.serverless.classes.Error('A local template path is required.');
+    }
+
+    const templateSrcDir = path.resolve(templatePath);
+    if (!this.serverless.utils.dirExistsSync(templateSrcDir)) {
+      throw new this.serverless.classes.Error(
+        `The template path "${templatePath}" does not exist or is not a directory.`
+      );
+    }
+
+    const boilerplatePath = _.toString(this.options.path);
+    const serviceName = _.toString(this.options.name);
+    const currentPath = process.cwd();
+    const templateFilePaths = this.serverless.utils.walkDirSync(templateSrcDir);
+    let targetPath = currentPath;
+
+    if (boilerplatePath) {
+      targetPath = path.join(currentPath, boilerplatePath);
+
+      if (this.serverless.utils.dirExistsSync(targetPath)) {
+        throw new this.serverless.classes.Error(
+          `The directory "${targetPath}" already exists, and serverless will not overwrite it.`
+        );
+      }
+
+      const relativeTargetPath = path.relative(templateSrcDir, targetPath);
+      if (relativeTargetPath === '' ||
+          (!path.isAbsolute(relativeTargetPath) &&
+            relativeTargetPath !== '..' &&
+            relativeTargetPath.split(path.sep)[0] !== '..')) {
+        throw new this.serverless.classes.Error(
+          'The destination directory cannot be inside the template directory.'
+        );
+      }
+
+      this.serverless.cli.log(`Generating boilerplate in "${targetPath}"`);
+      fse.mkdirsSync(targetPath);
+      process.chdir(targetPath);
+      targetPath = process.cwd();
+    } else {
+      templateFilePaths.forEach(filePath => {
+        const relativeFilePath = path.relative(templateSrcDir, filePath);
+        if (this.serverless.utils.fileExistsSync(path.join(targetPath, relativeFilePath))) {
+          throw new this.serverless.classes.Error(
+            `The file "${relativeFilePath}" already exists, and serverless will not overwrite it.`
+          );
+        }
+      });
+    }
+
+    try {
+      this.serverless.utils.copyDirContentsSync(templateSrcDir, targetPath);
+    } catch (err) {
+      throw new this.serverless.classes.Error([
+        'Error unable to create a service in this directory. ',
+        'Please check that you have the required permissions to write to the directory',
+      ].join(''));
+    }
+
+    this.serverless.config.update({ servicePath: targetPath });
+
+    const newServiceName = serviceName || (boilerplatePath && path.basename(boilerplatePath));
+    const serverlessYmlFilePath = path.join(targetPath, 'serverless.yml');
+    if (newServiceName && this.serverless.utils.fileExistsSync(serverlessYmlFilePath)) {
+      const serverlessYmlFileContent = fse.readFileSync(serverlessYmlFilePath).toString()
+        .replace(/service: .+/, `service: ${newServiceName}`);
+      fse.writeFileSync(serverlessYmlFilePath, serverlessYmlFileContent);
+    }
+
+    userStats.track('service_created', {
+      template: templatePath,
+      serviceName,
+    });
+
+    this.serverless.cli.asciiGreeting();
+    this.serverless.cli.log(`Successfully generated boilerplate from: "${templatePath}"`);
+  }
