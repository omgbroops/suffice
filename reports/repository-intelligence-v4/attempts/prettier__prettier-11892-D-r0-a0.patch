+test("allows calling the TypeScript parser without options", () => {
+  const { parse } = require("../../../src/language-js/parse/typescript.js").parsers.typescript;
+  const ast = parse("const value: number = 1;");
+  expect(ast.type).toBe("Program");
+  expect(ast.body[0].declarations[0].id.name).toBe("value");
+  expect(ast.body[0].loc.start).toEqual({ line: 1, column: 0 });
+});
+
+test("allows using the TypeScript parser in a custom parser", () => {
+  const output = prettier.format("const value:number=1", {
+    parser(text, parsers) {
+      return parsers.typescript(text);
+    },
+  });
+  expect(output).toBe("const value: number = 1;\n");
+});
