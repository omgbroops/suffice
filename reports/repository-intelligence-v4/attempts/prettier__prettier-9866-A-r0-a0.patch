+  // Non-ASCII whitespace is meaningful JSX text, so it is not handled by
+  // printJSXChildren as jsxWhitespace. Don't add a line separator before it:
+  // the character itself already separates the preceding child.
+  if (
+    nextNode &&
+    nextNode.type === "JSXText" &&
+    /^[^\S \t\r\n]/.test(rawText(nextNode))
+  ) {
+    return "";
+  }
+
   if (
     (childNode.type === "JSXElement" && !childNode.closingElement) ||
     (nextNode && nextNode.type === "JSXElement" && !nextNode.closingElement)
