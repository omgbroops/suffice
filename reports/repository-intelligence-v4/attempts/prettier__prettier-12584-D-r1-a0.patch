diff --git a/tests/format/vue/typescript/jsfmt.spec.js b/tests/format/vue/typescript/jsfmt.spec.js
new file mode 100644
index 0000000..ae79d08
--- /dev/null
+++ b/tests/format/vue/typescript/jsfmt.spec.js
@@ -0,0 +1,50 @@
+"use strict";
+
+const prettier = require("prettier-local");
+
+const format = (source) => prettier.format(source, { parser: "vue" });
+
+test.each(['lang="ts"', 'setup lang="ts"', 'lang="tsx"'])(
+  "formats TypeScript template expressions with %s",
+  (attributes) => {
+    const source = `<template>
+<p v-if="isFolder(file)">{{(file   as mymodule.Folder).deadline}}</p>
+</template>
+<script ${attributes}></script>`;
+    const output = format(source);
+    expect(output).toContain(
+      '<p v-if="isFolder(file)">{{ (file as mymodule.Folder).deadline }}</p>'
+    );
+    expect(format(output)).toBe(output);
+  }
+);
+
+test("formats TypeScript in directives, event handlers, and bindings", () => {
+  const source = `<script setup lang="ts"></script>
+<template>
+<div
+  v-if="(file   as Folder).ok"
+  v-for="file in files   as Folder[]"
+  :value="file! .name"
+  @click="foo($event   as Event);bar()"
+  @change="(event:Event)=>foo(event)"
+/>
+<Comp v-slot="{item}:{item:Folder}">{{item! .name}}</Comp>
+</template>`;
+  const output = format(source);
+  expect(output).toContain('v-if="(file as Folder).ok"');
+  expect(output).toContain('v-for="file in files as Folder[]"');
+  expect(output).toContain(':value="file!.name"');
+  expect(output).toContain("foo($event as Event);");
+  expect(output).toContain('@change="(event: Event) => foo(event)"');
+  expect(output).toContain('v-slot="{ item }: { item: Folder }"');
+  expect(format(output)).toBe(output);
+});
+
+test("preserves JavaScript Vue filters", () => {
+  const source =
+    "<template>{{message|capitalize}}</template><script>const value = 1;</script>";
+  const output = format(source);
+  expect(output).toContain("{{ message | capitalize }}");
+  expect(format(output)).toBe(output);
+});
