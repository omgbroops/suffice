@@ -497,6 +497,15 @@ class Variables {
   getValueFromSelf(variableString) {
     const valueToPopulate = this.service;
     const deepProperties = variableString.split(':')[1].split('.');
+    // The service declaration name is normalized to a string in the service model.
+    if (
+      deepProperties.length === 2 &&
+      deepProperties[0] === 'service' &&
+      deepProperties[1] === 'name' &&
+      _.isString(valueToPopulate.service)
+    ) {
+      return BbPromise.resolve(valueToPopulate.service);
+    }
     return this.getDeepValue(deepProperties, valueToPopulate);
   }
 
