+  createFromPath() {
+    const templatePathOption = _.toString(this.options['template-path']);
+    if (!templatePathOption) {
+      throw new this.serverless.classes.Error('A template path is required.');
+    }
+
+    const templatePath = path.resolve(templatePathOption);
+    if (!this.serverless.utils.dirExistsSync(templatePath)) {
+      throw new this.serverless.classes.Error(
+        `The template path "${templatePath}" does not exist or is not a directory.`
+      );
+    }
+
+    const boilerplatePath = _.toString(this.options.path);
+    const serviceName = _.toString(this.options.name);
+    const servicePath = boilerplatePath ?
+      path.resolve(process.cwd(), boilerplatePath) : process.cwd();
+    const relativeDestination = path.relative(templatePath, servicePath);
+    const destinationIsInsideTemplate = relativeDestination === '' ||
+      (!path.isAbsolute(relativeDestination) && relativeDestination !== '..' &&
+        !relativeDestination.startsWith(`..${path.sep}`));
+
+    if (destinationIsInsideTemplate) {
+      throw new this.serverless.classes.Error(
+        'The service path cannot be the same as or inside the template path.'
+      );
+    }
+
+    if (boilerplatePath) {
+      if (fse.existsSync(servicePath)) {
+        const errorMessage = [
+          `The directory "${servicePath}" already exists, and serverless will not overwrite it. `,
+          'Rename or move the directory and try again if you want serverless to create it',
+        ].join('');
+        throw new this.serverless.classes.Error(errorMessage);
+      }
+
+      this.serverless.cli.log(`Generating boilerplate in "${servicePath}"`);
+      fse.mkdirsSync(servicePath);
+    } else {
+      const templateFiles = this.serverless.utils.walkDirSync(templatePath);
+      templateFiles.forEach(templateFile => {
+        const relativeFilePath = path.relative(templatePath, templateFile);
+        if (fse.existsSync(path.join(servicePath, relativeFilePath))) {
+          const errorMessage = [
+            `The file "${relativeFilePath}" already exists, and serverless will not overwrite it. `,
+            'Move the file and try again if you want serverless to write a new file',
+          ].join('');
+          throw new this.serverless.classes.Error(errorMessage);
+        }
+      });
+    }
+
+    this.serverless.config.update({ servicePath });
+
+    try {
+      this.serverless.utils.copyDirContentsSync(templatePath, servicePath);
+
+      // NPM renames .gitignore to .npmignore on publish so we have to rename it.
+      if (fse.existsSync(path.join(servicePath, 'gitignore'))) {
+        fse.renameSync(path.join(servicePath, 'gitignore'),
+          path.join(servicePath, '.gitignore'));
+      }
+    } catch (err) {
+      const errorMessage = [
+        'Error unable to create a service in this directory. ',
+        'Please check that you have the required permissions to write to the directory',
+      ].join('');
+      throw new this.serverless.classes.Error(errorMessage);
+    }
+
+    if ((boilerplatePath || serviceName)) {
+      const newServiceName = serviceName || path.basename(servicePath);
+      renameService(newServiceName, servicePath);
+    }
+
+    userStats.track('service_created', {
+      template: 'local',
+      serviceName,
+    });
+
+    this.serverless.cli.asciiGreeting();
+    this.serverless.cli.log(`Successfully generated boilerplate from: "${templatePath}"`);
+  }
