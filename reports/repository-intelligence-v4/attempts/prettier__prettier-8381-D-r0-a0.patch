diff --git a/tests/misc/front-matter/jsfmt.spec.js b/tests/misc/front-matter/jsfmt.spec.js
new file mode 100644
index 0000000..c35a2c3
--- /dev/null
+++ b/tests/misc/front-matter/jsfmt.spec.js
@@ -0,0 +1,60 @@
+"use strict";
+
+const prettier = require("prettier/local");
+const parseFrontMatter = require("../../../src/utils/front-matter");
+
+describe("front matter with a language designation", () => {
+  for (const [parser, body, formattedBody] of [
+    ["html", "<h1>\n  Hello world!</h1>", "<h1>\n  Hello world!\n</h1>\n"],
+    ["markdown", "#   Hello", "# Hello\n"],
+    ["css", "a{color:red}", "a {\n  color: red;\n}\n"],
+  ]) {
+    for (const marker of [
+      "---mycustomparser",
+      "--- custom-parser",
+      "+++custom",
+    ]) {
+      test(`${parser}: ${marker}`, () => {
+        const frontMatter = `${marker}\n  \ntitle:   Hello\nslug: home\n\n${marker.slice(
+          0,
+          3
+        )}`;
+        const input = `${frontMatter}\n\n${body}`;
+        const output = prettier.format(input, { parser });
+        expect(output).toBe(`${frontMatter}\n\n${formattedBody}`);
+        expect(prettier.format(output, { parser })).toBe(output);
+      });
+    }
+
+    test(`${parser}: explicit YAML language`, () => {
+      expect(
+        prettier.format(`---yaml\ntitle:   Hello\n---\n\n${body}`, {
+          parser,
+        })
+      ).toBe(`---yaml\ntitle: Hello\n---\n\n${formattedBody}`);
+    });
+  }
+
+  test("preserves source offsets and raw text", () => {
+    const raw = "---custom\r\nvalue\r\n---\r\n";
+    const { frontMatter, content } = parseFrontMatter(raw + "body");
+    expect(frontMatter.lang).toBe("custom");
+    expect(frontMatter.value).toBe("value\r");
+    expect(content.length).toBe(raw.length + 4);
+    expect(content.slice(raw.length)).toBe("body");
+  });
+
+  test("requires a complete front matter block at the start", () => {
+    for (const text of [
+      "---custom\nvalue",
+      "---custom\nvalue\n---custom\n",
+      "\n---custom\nvalue\n---\n",
+      "---custom\nvalue\n+++\n",
+    ]) {
+      expect(parseFrontMatter(text)).toEqual({
+        frontMatter: null,
+        content: text,
+      });
+    }
+  });
+});
