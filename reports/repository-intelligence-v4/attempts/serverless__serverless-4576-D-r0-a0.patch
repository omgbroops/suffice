diff --git a/lib/plugins/create/templatePath.test.js b/lib/plugins/create/templatePath.test.js
new file mode 100644
index 0000000..68ac954
--- /dev/null
+++ b/lib/plugins/create/templatePath.test.js
@@ -0,0 +1,105 @@
+'use strict';
+
+const expect = require('chai').expect;
+const path = require('path');
+const fse = require('fs-extra');
+const sinon = require('sinon');
+const Create = require('./create');
+const Serverless = require('../../Serverless');
+const testUtils = require('../../../tests/utils');
+
+describe('Create from a local template', () => {
+  let cwd;
+  let tmpDir;
+  let source;
+  let create;
+
+  beforeEach(() => {
+    cwd = process.cwd();
+    tmpDir = testUtils.getTmpDirPath();
+    source = path.join(tmpDir, 'template');
+    fse.mkdirsSync(path.join(source, 'nested'));
+    fse.writeFileSync(path.join(source, 'serverless.yml'), 'service: original\n');
+    fse.writeJsonSync(path.join(source, 'package.json'), { name: 'original' });
+    fse.writeFileSync(path.join(source, 'nested', 'handler.js'), 'handler');
+    fse.writeFileSync(path.join(source, '.gitignore'), 'node_modules');
+    process.chdir(tmpDir);
+    const serverless = new Serverless();
+    serverless.cli = { log: sinon.spy(), asciiGreeting: sinon.spy() };
+    create = new Create(serverless, { 'template-path': 'template' });
+  });
+
+  afterEach(() => {
+    process.chdir(cwd);
+    fse.removeSync(tmpDir);
+  });
+
+  it('registers the local template option', () => {
+    expect(create.commands.create.options).to.have.property('template-path');
+  });
+
+  it('copies a relative template to cwd, preserving nested files and dotfiles', () =>
+    create.create().then(() => {
+      expect(fse.readFileSync(path.join(tmpDir, 'nested', 'handler.js'), 'utf8'))
+        .to.equal('handler');
+      expect(fse.readFileSync(path.join(tmpDir, '.gitignore'), 'utf8')).to.equal('node_modules');
+      expect(fse.readFileSync(path.join(tmpDir, 'serverless.yml'), 'utf8'))
+        .to.equal('service: original\n');
+      expect(create.serverless.config.servicePath).to.equal(tmpDir);
+    })
+  );
+
+  it('supports absolute source and destination paths and renames the service', () => {
+    create.options['template-path'] = source;
+    create.options.path = path.join(tmpDir, 'new-service');
+    return create.create().then(() => {
+      expect(fse.readFileSync(path.join(create.options.path, 'serverless.yml'), 'utf8'))
+        .to.equal('service: new-service\n');
+      expect(fse.readJsonSync(path.join(create.options.path, 'package.json')).name)
+        .to.equal('new-service');
+      expect(fse.readFileSync(path.join(source, 'serverless.yml'), 'utf8'))
+        .to.equal('service: original\n');
+    });
+  });
+
+  it('lets an explicit name override the destination basename', () => {
+    create.options.path = 'destination';
+    create.options.name = 'custom-name';
+    return create.create().then(() => {
+      expect(fse.readFileSync(path.join(tmpDir, 'destination', 'serverless.yml'), 'utf8'))
+        .to.equal('service: custom-name\n');
+    });
+  });
+
+  it('rejects missing paths and files as template sources', () => {
+    [undefined, '', 'missing', path.join(source, 'serverless.yml')].forEach(value => {
+      create.options['template-path'] = value;
+      expect(() => create.create()).to.throw('existing directory');
+    });
+  });
+
+  it('does not overwrite an existing destination directory', () => {
+    create.options.path = 'existing';
+    fse.mkdirsSync(path.join(tmpDir, 'existing'));
+    expect(() => create.create()).to.throw('will not overwrite');
+  });
+
+  it('checks cwd conflicts before copying any template files', () => {
+    fse.writeFileSync(path.join(tmpDir, 'serverless.yml'), 'keep');
+    expect(() => create.create()).to.throw('will not overwrite');
+    expect(fse.readFileSync(path.join(tmpDir, 'serverless.yml'), 'utf8')).to.equal('keep');
+    expect(fse.existsSync(path.join(tmpDir, 'nested'))).to.equal(false);
+  });
+
+  it('rejects copying a template into itself or a descendant', () => {
+    [source, path.join(source, 'child')].forEach(destination => {
+      create.options.path = destination;
+      expect(() => create.create()).to.throw('inside the template');
+    });
+  });
+
+  it('mentions the local option when no template source is supplied', () => {
+    create.options = {};
+    expect(() => create.create()).to.throw('--template-path');
+  });
+});
