+
+  it("uses and removes a custom cache location", async () => {
+    const args = [
+      "--cache",
+      "--cache-location",
+      ".custom-prettier-cache",
+      "--write",
+      ".",
+    ];
+    const { stdout: firstStdout } = await runPrettier(dir, args);
+    expect(stripAnsi(firstStdout)).not.toContain("(cached)");
+    await expect(fs.stat(customCacheFile)).resolves.not.toThrowError();
+    await expect(fs.stat(defaultCacheFile)).rejects.toHaveProperty(
+      "code",
+      "ENOENT"
+    );
+
+    const { stdout: secondStdout } = await runPrettier(dir, args);
+    expect(stripAnsi(secondStdout)).toContain("(cached)");
+
+    await runPrettier(dir, [
+      "--cache-location",
+      ".custom-prettier-cache",
+      "--write",
+      ".",
+    ]);
+    await expect(fs.stat(customCacheFile)).rejects.toHaveProperty(
+      "code",
+      "ENOENT"
+    );
+  });
 });
