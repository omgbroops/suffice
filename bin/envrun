#!/usr/bin/env node
// Agent-side client: sends the current directory (minus .git) to the harness broker (src/v4-envrun.mjs), which runs the command in the task container.
// Env: V4_ENVRUN_SOCK (broker unix socket). Node built-ins only. Frame format is documented in src/v4-envrun.mjs.
import { spawn } from 'node:child_process';
import { connect } from 'node:net';

const cmd = process.argv.slice(2).join(' ');
const sock = process.env.V4_ENVRUN_SOCK;
if (!sock || !cmd) {
  console.error('usage: envrun <shell command>   (needs V4_ENVRUN_SOCK; the harness sets it)');
  process.exit(2);
}

const socket = connect(sock);
socket.on('error', error => { console.error(`envrun: ${error.message}`); process.exitCode = 127; });
socket.write(`${JSON.stringify({ cmd })}\n`);
const tar = spawn('tar', ['-cf', '-', '--no-xattrs', '--exclude=.git', '.'], { stdio: ['ignore', 'pipe', 'inherit'], env: { ...process.env, COPYFILE_DISABLE: '1' } });
tar.stdout.pipe(socket);

let buf = Buffer.alloc(0);
let code = null;
socket.on('data', chunk => {
  buf = Buffer.concat([buf, chunk]);
  while (buf.length >= 5 && buf.length >= 5 + buf.readUInt32BE(1)) {
    const len = buf.readUInt32BE(1);
    const payload = buf.subarray(5, 5 + len);
    if (buf[0] === 1) process.stdout.write(payload);
    else code = payload.readInt32BE(0);
    buf = buf.subarray(5 + len);
  }
});
socket.on('close', () => { if (process.exitCode === undefined) process.exitCode = code ?? 1; });
