{
  "name": "suffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Controlled experiments for an adaptive Pi-based coding harness",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pi": "node scripts/pi.mjs",
    "login": "node scripts/login.mjs",
    "preflight": "node scripts/preflight.mjs",
    "smoke:models": "node scripts/smoke-models.mjs",
    "smoke:watchers": "node scripts/smoke-watchers.mjs",
    "experiment": "node scripts/experiment.mjs",
    "pilot": "node scripts/run-pilot.mjs",
    "report": "node scripts/report.mjs",
    "privacy-check": "node scripts/privacy-check.mjs",
    "v9": "node scripts/v9-run.mjs",
    "v9:preflight": "node scripts/v9-preflight.mjs",
    "v9:bench": "node scripts/v9-bench.mjs",
    "v9:report": "node scripts/v9-report.mjs",
    "test:v9": "node --test tests/v9-*.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "typebox": "1.3.27"
  }
}
