{
  "name": "suffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "suffice": "packages/cli/bin/suffice.mjs"
  },
  "files": [
    "packages/cli/bin/",
    "packages/cli/src/",
    "packages/cli/README.md",
    "packages/cli/THIRD-PARTY-NOTICES.md"
  ],
  "description": "Controlled experiments for an adaptive Pi-based coding harness",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pi": "node scripts/pi.mjs",
    "login": "node scripts/login.mjs",
    "preflight": "node scripts/preflight.mjs",
    "smoke:models": "node scripts/smoke-models.mjs",
    "smoke:watchers": "node scripts/smoke-watchers.mjs",
    "experiment": "node scripts/experiment.mjs",
    "pilot": "node scripts/run-pilot.mjs",
    "report": "node scripts/report.mjs",
    "privacy-check": "node scripts/privacy-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "bun run apps/desktop/electron/dev.mjs",
    "desktop:build": "bun run --cwd apps/desktop build",
    "test:desktop": "node --test --test-concurrency=1 apps/desktop/test/*.test.mjs",
    "desktop:setup": "bun node_modules/electron/install.js",
    "postinstall": "bun run desktop:setup"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "diff": "8.0.4",
    "typebox": "1.3.27"
  },
  "workspaces": [
    "packages/cli",
    "packages/harness",
    "apps/desktop"
  ],
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "electron": "45.3.0",
    "playwright-core": "^1.65.0"
  }
}
