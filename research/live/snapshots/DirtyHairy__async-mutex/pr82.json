    "starred_url": "https://api.github.com/users/alveifbklsiu259/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/alveifbklsiu259/subscriptions",
    "organizations_url": "https://api.github.com/users/alveifbklsiu259/orgs",
    "repos_url": "https://api.github.com/users/alveifbklsiu259/repos",
    "events_url": "https://api.github.com/users/alveifbklsiu259/events{/privacy}",
    "received_events_url": "https://api.github.com/users/alveifbklsiu259/received_events",
