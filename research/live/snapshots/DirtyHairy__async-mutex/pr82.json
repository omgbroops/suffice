  "locked": false,
  "title": "Add new feature to mutex and semaphore - cancelUnlockWaiters: Cancel pending unlocks.",
  "user": {
    "login": "alveifbklsiu259",
    "id": 102334645,
    "node_id": "U_kgDOBhmAtQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/102334645?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/alveifbklsiu259",
