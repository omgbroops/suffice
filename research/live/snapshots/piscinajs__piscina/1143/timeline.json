      "updated_at": "2026-09-04T01:26:28Z",
      "body": "I rewrote the reproduction code using `node:worker_threads` and got some interesting results.\n\nworker.js:\n```js\nconst { parentPort, workerData } = require(\"node:worker_threads\");\nconst { serializeError } = require(\"serialize-error\");\n\nconst functionMap = {\n  fn1() {\n    return Object.assign(new Error(\"ERROR\"), { foo: \"bar\" });\n  },\n  fn2() {\n    return serializeError(Object.assign(new Error(\"ERROR\"), { foo: \"bar\" }));\n  },\n  fn3() {\n    throw Object.assign(new Error(\"ERROR\"), { foo: \"bar\" });\n  },\n};\n\nparentPort.postMessage(functionMap[workerData]());\n```\n\nmain.js:\n```js\nconst { Worker } = require(\"node:worker_threads\");\nconst path = require(\"node:path\");\nconst assert = require(\"node:assert\");\n\nfunction runWorker(workerData) {\n  return new Promise((resolve, reject) => {\n    const worker = new Worker(path.join(__dirname, \"worker.js\"), {\n      workerData,\n    });\n    worker.on(\"message\", resolve);\n    worker.once(\"error\", reject);\n    worker.once(\"exit\", (code) => {\n      if (code !== 0)\n        reject(new Error(`Worker stopped with exit code ${code}`));\n    });\n  });\n}\n\n(async function runTests() {\n  {\n    const error = await runWorker(\"fn1\");\n    assert.strictEqual(error.name, \"Error\");\n    assert.strictEqual(error.message, \"ERROR\");\n    assert.strictEqual(typeof error.stack, \"string\");\n    // Custom properties are lost.\n    assert.strictEqual(error.foo, undefined);\n    assert.deepStrictEqual(Object.keys(error), []);\n  }\n\n  {\n    const error = await runWorker(\"fn2\");\n    assert.strictEqual(error.name, \"Error\");\n    assert.strictEqual(error.message, \"ERROR\");\n    assert.strictEqual(typeof error.stack, \"string\");\n    // Custom properties are preserved.\n    assert.strictEqual(error.foo, \"bar\");\n    // Native error properties are properly handled by `serializeError()` as well.\n    // But these properties are all enumerable now.\n    assert.deepStrictEqual(Object.keys(error), [\n      \"foo\",\n      \"name\",\n      \"message\",\n      \"stack\",\n    ]);\n  }\n\n  try {\n    await runWorker(\"fn3\");\n  } catch (error) {\n    assert.strictEqual(error.name, \"Error\");\n    assert.strictEqual(error.message, \"ERROR\");\n    assert.strictEqual(typeof error.stack, \"string\");\n    // Custom properties are preserved.\n    assert.strictEqual(error.foo, \"bar\");\n    // Only the custom property is enumerable, the native properties are non-enumerable as they were originally.\n    assert.deepStrictEqual(Object.keys(error), [\"foo\"]);\n  }\n})();\n```\n\nIn `fn1` & `fn2`, I didn't throw the error; I just passed it like a successful value using `parentPort.postMessage()`. Then I reproduced exactly what I got with Piscina — the custom properties are lost and can be preserved by using `serialize-error`.\n\nIn `fn3`, I just threw the error, and then `node:worker_threads` captured it & passed it back to the main thread. In this case the custom properties were preserved, but with a slightly different behavior than `serialize-error`. The native properties (`name`, `message` & `stack`) remained non-enumerable just as they were originally, while `serialize-error` would make them enumerable (`Object.keys(error)` is `[\"foo\"]` in `fn3` while `Object.keys(error)` is `[\"foo\",\"name\",...]` in `fn2`).\n\nIf you run this new code, you might still not see any assertion errors, which actually means you’re getting exactly the same result as I did, i.e. the custom properties are lost. In the code, I simply described what I actually got, not what was expected. I’m sorry for the confusion this caused.\n\nI did some research on the processing behind it. [`parentPort.postMessage()` uses the HTML structured clone algorithm](https://nodejs.org/api/worker_threads.html#portpostmessagevalue-transferlist). It's [said](https://share.google/aimode/ears0cRvGOOBUsrgp) that `structuredClone()` will ignore those custom properties when cloning an Error object. So it's by design and not considered a bug of Node.js. We may have no other choice but to handle these properties ourselves in Piscina, at least for now.\n",
      "author_association": "NONE",
      "pin": null,
