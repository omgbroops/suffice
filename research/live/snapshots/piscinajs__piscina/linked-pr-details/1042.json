  "title": "fix: include skipQueue tasks in queueSize getter (backport to v5)",
  "user": {
    "login": "algojogacor",
    "id": 239139125,
    "node_id": "U_kgDODkD5NQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/239139125?v=4",
