  "locked": false,
  "title": "fix: stop the hook chain as soon as an async hook has replied",
  "user": {
    "login": "itz-puneet",
    "id": 117641393,
    "node_id": "U_kgDOBwMQsQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/117641393?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/itz-puneet",
    "html_url": "https://github.com/itz-puneet",
    "followers_url": "https://api.github.com/users/itz-puneet/followers",
    "following_url": "https://api.github.com/users/itz-puneet/following{/other_user}",
    "gists_url": "https://api.github.com/users/itz-puneet/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/itz-puneet/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/itz-puneet/subscriptions",
    "organizations_url": "https://api.github.com/users/itz-puneet/orgs",
    "repos_url": "https://api.github.com/users/itz-puneet/repos",
    "events_url": "https://api.github.com/users/itz-puneet/events{/privacy}",
    "received_events_url": "https://api.github.com/users/itz-puneet/received_events",
    "type": "User",
