      "created_at": "2026-04-05T21:19:44Z",
      "updated_at": "2026-04-05T21:19:58Z",
      "body": "@john30 I was curious what the behavior looked like in other librarys, so I fed the same date into date-fns and got this:\n\n```\nconst { DateTime } = require(\"luxon\");\nconst l = DateTime.fromObject({\n    year: 2026,\n    month: 3,\n    day: 29,\n    hour: 2,\n    minute: 30,\n}, {\n    zone: \"Europe/Stockholm\"\n})\nconsole.log(\"Luxon\")\nconsole.log(`Valid: ${l.isValid}`)\nconsole.log(`Time: ${l.hour}:${l.minute}`)\n\nconst {TZDate} = require(\"@date-fns/tz\")\nconst d = new TZDate(\"2026-03-29 02:30:00\", \"Europe/Stockholm\")\nconsole.log(\"date-fns\")\nconsole.log(`Time: ${d.getHours()}:${d.getMinutes()}`)\n```\n\n```\n% yarn start\nLuxon\nValid: true\nTime: 3:30\ndate-fns\nTime: 3:30\n```",
      "author_association": "CONTRIBUTOR",
      "pin": null,
