  "findings": [
    {
      "id": "H1",
      "severity": "confirmed_posthoc_public_api_regression",
      "affected": [
        "s01-stock-pi"
      ],
      "primaryAccepted": true,
      "primaryBudgetEligible": false,
      "contract": "Existing native public contract forbids userland emit/emitSerial of listenerAdded or listenerRemoved.",
      "sourceCause": "emitMetaEvent is now async and keeps pendingMetaEvents.has(emitter) true across await emitter.emit(...). Both public emit methods treat the presence of any pending internal meta emission as blanket permission, not an unforgeable per-emission authorization.",
      "minimalSequence": "const e = new Emittery(); e.on('ordinary', () => {}); await e.emit(Emittery.listenerAdded, {eventName: 'forged'});",
      "posthocEvidence": "All four combinations of emit/emitSerial and listenerAdded/listenerRemoved fulfilled in Pi. Base, actual upstream reference and Suffice rejected TypeError in all four. No async subclass or internal state inspection is required.",
      "scope": "This is introduced relative to base, not merely a missing robustness enhancement. Six primary private tests exercise legitimate asynchronous meta delivery after settling, not unauthorized emission in the pending window.",
      "primaryScoresChanged": false
    },
    {
      "id": "H2",
      "severity": "confirmed_posthoc_public_api_regression",
      "affected": [
        "i04-stock-pi"
      ],
      "primaryAccepted": true,
      "primaryBudgetEligible": false,
      "contract": "A worker may synchronously pause its queue; pause/resume and concurrency mutation must return while leaving queued jobs paused.",
      "sourceCause": "Setter and resume while loops test queueHead and running<concurrency but not self.paused on each iteration. A started worker pauses; release() then decrements running without advancing queueHead. The loop repeats forever.",
      "minimalSequence": "Pause queue with several pending jobs; resume with a worker that immediately calls queue.pause(). Alternatively increase concurrency while an already queued worker pauses from its own invocation.",
      "posthocEvidence": "Pi prints before marker but never after marker in both setter and resume probes; bounded2s processes terminate124. Base returns in both; Suffice returns with paused=true and expected started jobs. Actual upstream reference also hangs in both.",
      "scope": "Resume case clearly regresses from finite base behavior. The actual reference shares the defect, so baseline-fail/reference-pass primary controls cannot establish completeness on this state transition.",
      "primaryScoresChanged": false
    },
    {
      "id": "H3",
      "severity": "informational_api_tightening",
      "affected": [
        "i04-suffice",
        "i04-stock-pi"
      ],
      "contract": "Original issue explicitly calls fractional1.2 nonsensical.",
      "sourceCause": "Both constructors and setters now require Number.isInteger(value)&&value>=1.",
      "posthocEvidence": "Both reject1.2 for construction and assignment and retain the prior valid value, covering the explicit original example omitted by primary grading. Both also reject Infinity, which base and reference accept.",
      "scope": "Infinity policy is not explicitly specified by the original report or inspected docs; record compatibility tightening without inventing a required Infinity policy or calling it a confirmed task failure. The raw guard probe serializes accepted Infinity as JSON null in retained, a serialization artifact, not a runtime null assignment.",
      "primaryScoresChanged": false
    },
    {
      "id": "H4",
      "severity": "coverage_gap_checked_no_regression_found",
      "affected": [
        "q04-suffice",
        "q04-stock-pi"
      ],
      "contract": "Public get() must give current derived value even without active listeners; epoch must be shared across separately loaded module copies.",
      "sourceCause": "Both store one mutable {value:0} object on globalThis under Symbol.for(nanostores.epoch), increment its value in atom.notify and read the shared value in all computed cache comparisons.",
      "posthocEvidence": "After initial foreign computed.get()=6, cleanStores unmounts it, foreign atom changes2to4, then get() returns12 for both patches and reference. Base remains stale6.",
      "representationAndTypes": "The object-versus-number representation is not a prescribed public ABI. root index.js does not export epoch, package exports expose only root/package.json, and atom/index.d.ts did not declare epoch even before the patch. No public declaration change or supported-export type regression was found.",
      "scope": "Primary grader loads two complete source copies and validates subscribed one/multi-source updates. It does not actually run a bundler/tree-shaker. Global writes are structurally observable to an optimizer, but an actual production bundler configuration remains unverified.",
      "primaryScoresChanged": false
    }
  ],
  "staticTaskReview": {
    "s01": {
      "suffice": "Minimal base-prototype dispatch bypasses an asynchronous subclass override for internal metadata, keeping the synchronous permission window closed on return. No introduced regression found in reviewed change or reserved-event probe. The old global flag remains; this review does not claim to remove all pre-existing reentrant/debug logger edge cases.",
      "stock-pi": "Legitimate asynchronous delivery passes primary tests, but H1 confirms a new pending-window authorization regression."
    },
    "i01": {
      "both": "The narrow try/catch around redirect Location parsing rejects FetchError, finalizes and returns, except manual mode preserves the original response. This is structurally equivalent to actual upstream behavior. No introduced API regression found. Primary private statuses omit303, but generic isRedirect handling and branch do not special-case it."
    },
    "i02": {
      "both": "Both add a hasData flag and resolve an empty response on raw.end, preserving the original wrapped/raw decompression branch. Primary nonempty and empty framing controls pass. Actual upstream additionally guards pipeline callbacks against success-as-rejection; those broader baseline issues are not changed here. No introduced regression found statically; no new broad HTTP test battery was run."
    },
    "i03": {
      "both": "Both track generated promises while retaining Array.from semantics, call Promise.allSettled on iterator failure without awaiting it, and rethrow the original iterator error. This observes mapper rejections without blocking immediate rejection and preserves array-like inputs, order and shared limiter behavior. Aggregate promise references can persist until pending tasks settle, a reasonable failure-path tradeoff rather than a demonstrated contract violation."
    },
    "i04": {
      "suffice": "startAvailable tests !paused each loop iteration, preserving reentrant pause. Construction and assignment reject fractional values explicitly named by the issue. Infinity acceptance is tightened (H3), with no required policy inferred.",
      "stock-pi": "Guard covers fractions, but setter/resume loop lacks reentrant pause guard; H2 confirms hang also present in actual upstream reference."
    },
    "q04": {
      "both": "Shared object is valid representation-neutral repair. All epoch comparisons use epoch.value. Root exports/declarations stay compatible; subscribed primary controls and additional dormant cross-copy get scenario pass. Actual tree-shaking and heterogeneous independently chosen global storage conventions remain outside demonstrated coverage; no requirement to interoperate with an unrelated implementation is imposed."
    }
  },
