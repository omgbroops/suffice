      "contents_url": "https://api.github.com/repos/sindresorhus/p-queue/contents/test%2Fbasic.ts?ref=22edad49b42214b9b5add8312391401c063d8b27",
      "patch": "@@ -1465,3 +1465,32 @@ test('.onError() - works when called before adding tasks', async () => {\n \t\t{message: 'Early error'},\n \t);\n });\n+\n+test('an active listener cannot exceed the concurrency limit', async t => {\n+\t// `active` was emitted before `pending` was incremented, so a listener that enqueued work re-entered the\n+\t// start check while the limit still looked free, and a second task ran alongside the first.\n+\tconst queue = new PQueue({concurrency: 1});\n+\tlet live = 0;\n+\tlet maxLive = 0;\n+\tlet added = false;\n+\n+\tconst task = async () => {\n+\t\tlive++;\n+\t\tmaxLive = Math.max(maxLive, live);\n+\t\tawait delay(10);\n+\t\tlive--;\n+\t};\n+\n+\tqueue.on('active', () => {\n+\t\tif (!added) {\n+\t\t\tadded = true;\n+\t\t\tqueue.add(task);\n+\t\t}\n+\t});\n+\n+\tawait queue.add(task);\n+\tawait queue.onIdle();\n+\n+\tassert.strictEqual(maxLive, 1);\n+\tassert.strictEqual(queue.size, 0);\n+});"
    }
