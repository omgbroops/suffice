        "pull_request": {
          "url": "https://api.github.com/repos/nanostores/nanostores/pulls/419",
          "html_url": "https://github.com/nanostores/nanostores/pull/419",
          "diff_url": "https://github.com/nanostores/nanostores/pull/419.diff",
