  "title": "Fix: store epoch on globalThis to prevent separate module instances from diverging",
  "user": {
    "login": "afurm",
    "id": 6375192,
    "node_id": "MDQ6VXNlcjYzNzUxOTI=",
    "avatar_url": "https://avatars.githubusercontent.com/u/6375192?v=4",
